DISCORD_TOKEN=your-bot-token-here

# Bot status text (shows as a custom status: "<BOT_STATUS>"). Leave empty to disable.
BOT_STATUS=your-status-text-here

# UID/GID the container runs as — set to your host user (run `id -u` / `id -g`)
# so the bot can write the bind-mounted config.json. Only used at build time.
PUID=1000
PGID=1000

# Web configuration UI (optional). Enabled when DISCORD_CLIENT_ID and
# DISCORD_CLIENT_SECRET are set. Create them in the Discord Developer Portal
# under your application's OAuth2 page, and add WEB_BASE_URL/login as a
# redirect URI (e.g. https://bot.example.com/callback).
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_BASE_URL=http://localhost:8080
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Random string used to sign session cookies. Generate with `openssl rand -hex 32`.
WEB_SESSION_SECRET=
